requires_version 0.2.43
# this include file can be customized with the following defines:
#   module_posix_timer_base
#     (optional) path to module-posix-timer-base-directory
#     e.g. /volume/software/common/packages/module_posix_timer/latest
#     or to a local reltool path,
#     or to a local install like: /home/schm_fl/workspace/module_posix_timer/build/sled11-x86-gcc4.x
#     defaults to rmpm structure

defines
module_posix_timer_base: %(ifndef "module_posix_timer_base", "%(dirname %(dirname %(CURDIR)))")
module_posix_timer_base_type: %(ifexists "%(module_posix_timer_base)/lib/libmodule_posix_timer.so", "local_install", "rmpm_release")
module_posix_timer_libdir: %(ifeq "%(module_posix_timer_base_type)", "local_install", "%(module_posix_timer_base)/lib", "%(module_posix_timer_base)/lib/$(ARCH)")

ifndef rk_modules: rk_modules: ""
rk_modules: %(rk_modules):%(module_posix_timer_libdir)

