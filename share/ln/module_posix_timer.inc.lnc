requires_version 0.2.43
# this include file can be customized with the following defines:
#   module_posix_timer_base
#     (optional) path to module-posix-timer-base-directory
#     e.g. /volume/software/common/packages/module_posix_timer/latest
#     or to a local reltool path,
#     or to a local install like: /home/schm_fl/workspace/module_posix_timer/build/sled11-x86-gcc4.x
#     defaults to rmpm structure

defines
module_posix_timer_base:          %(dirname %(dirname %(CURDIR)))
module_posix_timer_libdir:        %(subst "${exec_prefix}/", "", "@libdir@")
module_posix_timer_type:          %(ifexists "%(module_posix_timer_base)/%(module_posix_timer_libdir)/libmodule_posix_timer.so", "local_install", "rmpm_release")
module_posix_timer_library_path:  %(ifeq "%(module_posix_timer_type)", "local_install", "%(_base)/%(module_posix_timer_libdir)", "%(module_posix_timer_base)/lib/$(ARCH)")

ifndef rk_library_path: rk_library_path: ""
rk_library_path: %(rk_library_path):%(module_posix_timer_library_path)

